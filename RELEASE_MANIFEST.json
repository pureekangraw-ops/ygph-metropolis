{
  "product": "LIGHTHOUSE",
  "architecture": "LIGHTHOUSE_NEXT",
  "status": "PRODUCTION_TARGET",
  "productionBranch": "main",
  "authority": {
    "builder": "scripts/stage-lighthouse-next-bundle.mjs",
    "assetsDirectory": ".lighthouse-production",
    "webEntrypoint": "lighthouse-next/index.html",
    "rootEntrypoint": "index.html",
    "androidBuilder": "android-shell/tools/stage-lighthouse-next.mjs",
    "rule": "WEB_AND_ANDROID_MUST_USE_SAME_STAGED_BUNDLE"
  },
  "surfaces": {
    "roots": [
      "CHAT",
      "MANUAL",
      "GO",
      "SETTINGS"
    ],
    "goClient": {
      "path": "/client",
      "entry": "client/index.html"
    }
  },
  "runtimeTruth": {
    "greenfield": "RUNTIME_DEPENDENCY_ONLY_NOT_UI_AUTHORITY",
    "lighthousePath": "CAPABILITY_DEPENDENCY_ONLY"
  },
  "legacy": {
    "product": "YGPH METROPOLIS",
    "shellAuthority": "ROLLBACK_ONLY_NOT_DEPLOYED",
    "forbiddenProductionFiles": [
      "ui/lighthouse-shell.mjs",
      "ui/home-ui.mjs",
      "ui/store-ui.mjs",
      "ui/finance-ui.mjs",
      "ui/ride-ui.mjs"
    ],
    "forbiddenProductionMarkers": [
      "YGPH METROPOLIS",
      "MASTER INPUT"
    ]
  },
  "serviceWorker": {
    "generatedBy": "scripts/stage-lighthouse-next-bundle.mjs",
    "cachePrefix": "lighthouse-",
    "cleansLegacyPrefix": "ygph-metropolis-"
  },
  "provenance": {
    "runtimeManifest": "release-manifest.json",
    "buildIdentity": "lighthouse-next/build-identity.json",
    "sourceCommit": "GITHUB_SHA_WHEN_BUILT_IN_CI"
  },
  "validation": {
    "command": "npm run deploy:gate",
    "deviceAcceptanceRequired": true,
    "ownerAcceptanceRequired": true
  }
}
