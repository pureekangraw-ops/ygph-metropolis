{
  "manifest_version": 3,
  "name": "ERGASTERION Factory Eye",
  "version": "0.4.0",
  "description": "Owner-paired neutral tab-level Firefox observer for the ERGASTERION Runtime Workbench.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-observer.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "ERGASTERION Factory Eye"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ergasterion-factory-eye@pureekangraw.local",
      "data_collection_permissions": {
        "required": [
          "websiteActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {}
  }
}
