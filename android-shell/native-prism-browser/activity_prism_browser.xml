<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#070b13">
  <TextView android:id="@+id/prism_eye_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="Factory Eye · installing" android:textColor="#9fc2ff"/>
  <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:id="@+id/prism_tabs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="6dp">
    <Button android:id="@+id/prism_back" android:layout_width="44dp" android:layout_height="44dp" android:text="‹"/>
    <Button android:id="@+id/prism_forward" android:layout_width="44dp" android:layout_height="44dp" android:text="›"/>
    <EditText android:id="@+id/prism_url" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:singleLine="true" android:inputType="textUri" android:imeOptions="actionGo" android:hint="URL หรือค้นหา" android:textColor="#ffffff" android:textColorHint="#8b98aa"/>
    <Button android:id="@+id/prism_go" android:layout_width="wrap_content" android:layout_height="44dp" android:text="ไป"/>
    <Button android:id="@+id/prism_reload" android:layout_width="44dp" android:layout_height="44dp" android:text="↻"/>
    <Button android:id="@+id/prism_watch" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Watch"/>
  </LinearLayout>
  <org.mozilla.geckoview.GeckoView android:id="@+id/prism_gecko" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
