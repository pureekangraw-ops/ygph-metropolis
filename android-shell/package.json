{
  "name": "lighthouse-android-shell",
  "version": "1.0.0-owner-test",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app:stage-next": "node tools/stage-lighthouse-next.mjs",
    "test": "node --test test/*.test.mjs",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:security:apply": "node tools/apply-android-security.mjs android",
    "android:security:verify": "node tools/verify-android-security.mjs android release/android-security-evidence.json",
    "android:icons": "node tools/materialize-android-icons.mjs android",
    "android:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/app": "8.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "sharp": "0.34.3"
  }
}
