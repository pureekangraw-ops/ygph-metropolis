{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ygph-metropolis",
  "compatibility_date": "2026-08-02",
  "main": "worker/index.mjs",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "INTERPRET_RATE_LIMITER",
      "namespace_id": "926082601",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "name": "ygph-metropolis-staging",
      "secrets": {
        "required": [
          "OPENAI_API_KEY"
        ]
      },
      "ratelimits": [
        {
          "name": "INTERPRET_RATE_LIMITER",
          "namespace_id": "926082602",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
