{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ygph-metropolis",
  "compatibility_date": "2026-08-02",
  "main": "worker/index.mjs",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "INTERPRET_RATE_LIMITER",
      "namespace_id": "926082601",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
